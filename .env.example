# OpenClaw Control UI and Gateway (local development only)
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=

# Optional on first boot. When set, OpenClaw stores an environment SecretRef,
# not this value, in openclaw.json. Without it the Gateway still starts, but the
# agent cannot run model turns until a provider is configured.
OPENAI_API_KEY=

# The AG Pay plugin accepts plain HTTP only on loopback. The playground keeps
# that invariant by forwarding container loopback to the API on the host.
AGPAY_API_URL=http://127.0.0.1:8000
AGPAY_PROXY_ENABLED=1
AGPAY_HOST=host.docker.internal
AGPAY_HOST_PORT=8000
